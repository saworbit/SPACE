# Build output
/target/
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
# Cargo.lock is committed for reproducible builds (this is an application, not a library)

# Coverage, profiling and mutation testing
*.profraw
*.profdata
lcov.info
/coverage/
/mutants.out*/

# SPACE runtime files (spacectl keeps a store in its working directory)
*.nvram
*.nvram.segments
*.metadata
**/space.db/
**/space.journal
**/space.audit.log
*.compact
**/space.storage/

# Key material. A master key belongs in SPACE_MASTER_KEY or a key file
# outside the repository, never in a commit.
*.key
*.pem
.env
.env.*

# Test files
test.txt
test*.bin
test*.nvram*
test_nvram_*.log
test_nvram_*.log.segments
bigfile.bin
output.txt
retrieved_s3.txt
downloaded.bin
test_demo.txt

# Dedup test artifacts
demo_repeated.txt
demo_unique*.txt
test_dedup*.nvram*
test_dedup*.metadata

# Editors and IDEs
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# Leftovers from patches and merges
*.orig
*.rej

# Claude Code
/.claude/
/.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini
