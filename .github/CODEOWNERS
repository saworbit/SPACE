# CODEOWNERS — Auto-assign reviewers based on file paths
# https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners
#
# Map each subsystem to its maintainer(s) so PRs are automatically
# routed for review.
#
# As the team grows, replace individual handles with @org/team slugs.

# ── Global fallback ──────────────────────────────────────────────
*                                       @saworbit

# ── Core storage pipeline ────────────────────────────────────────
crates/common/                          @saworbit
crates/capsule-registry/                @saworbit
crates/pipeline/                        @saworbit
crates/storage/                         @saworbit
crates/nvram-sim/                       @saworbit

# ── Data services (encryption, compression, dedup) ───────────────
crates/encryption/                      @saworbit
crates/compression/                     @saworbit
crates/dedup/                           @saworbit

# ── Protocol views ───────────────────────────────────────────────
crates/protocol-s3/                     @saworbit

# ── CLI & web ────────────────────────────────────────────────────
crates/spacectl/                        @saworbit

# ── Build, CI, and tooling ───────────────────────────────────────
.github/                                @saworbit
Cargo.toml                              @saworbit
Cargo.lock                              @saworbit
deny.toml                               @saworbit
LICENSE                                 @saworbit

# ── Security-sensitive files (require explicit review) ───────────
SECURITY.md                             @saworbit
crates/encryption/                      @saworbit

# ── Documentation ────────────────────────────────────────────────
docs/                                   @saworbit
